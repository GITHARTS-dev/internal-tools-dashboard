{
  "name": "internal-tools-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/dev.ts",
    "dev:web": "vite",
    "build": "npm run build:azure",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generate": "node scripts/generate-seed.mjs > seed/dev-seed.sql && node scripts/seed-to-module.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "demo:data": "node scripts/build-demo-data.mjs > src/client/demo/data.json",
    "build:api": "node scripts/build-api.mjs",
    "build:azure": "tsc --noEmit && vite build && npm run build:api",
    "migrate:pg": "node scripts/migrate-postgres.mjs",
    "db:reset": "node scripts/reset-dev-db.mjs",
    "seed:local": "node scripts/reset-dev-db.mjs"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
