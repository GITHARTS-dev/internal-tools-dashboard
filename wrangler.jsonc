{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "internal-tools-dashboard",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tools_db",
      // Placeholder. `wrangler d1 create tools_db` prints the real id; it goes
      // in the `env.production` block below, not here, so local development
      // can never be pointed at the live database by accident.
      "database_id": "local-development-only"
    }
  ],
  "triggers": {
    // 03:00 UTC == 08:30 IST. Only fires once deployed; locally we invoke
    // the same handler by hand via `wrangler dev` or the dry-run endpoint.
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "FEATURE_DOCUMENTS": "false",
    "APP_ENV": "development"
  },

  // Deployment is on hold (see PRODUCT.md). This block is what makes lifting
  // that hold a matter of filling in one id and running two commands rather
  // than working out the shape of the config under time pressure.
  //
  // Everything secret -- the Teams webhook URL, any email credential -- is set
  // with `wrangler secret put`, never written here. This file is committed.
  "env": {
    "production": {
      "name": "internal-tools-dashboard",
      "assets": {
        "directory": "./dist/client",
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tools_db",
          // TODO: paste the id printed by `wrangler d1 create tools_db`.
          "database_id": "REPLACE_WITH_REAL_D1_ID"
        }
      ],
      "triggers": {
        "crons": ["0 3 * * *"]
      },
      "vars": {
        "FEATURE_DOCUMENTS": "false",
        "APP_ENV": "production"
      },
      "observability": {
        // Worker logs, so a failed reminder run is diagnosable after the fact.
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
